# ============================================================================
# AI 运维平台 - 生产环境环境变量配置示例
# ============================================================================
#
# 使用方法：
#   1. cp deployments/.env.production.example deployments/.env.production
#   2. 逐项填写下方所有 [必填] 变量
#   3. 启动：docker compose --env-file deployments/.env.production \
#             -f deployments/docker-compose.prod.yml up -d
#
# 安全要求：
#   - 所有密钥必须使用 openssl rand -base64 32 或等效方式生成强随机值。
#   - 不得将此文件提交到版本控制系统（.gitignore 应包含 .env.production）。
#   - 生产环境建议通过 CI/CD Secret 或密钥管理服务注入，而非明文文件。
#
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL 数据库配置
# ----------------------------------------------------------------------------

# [必填] PostgreSQL 数据库密码
# 生成方式：openssl rand -base64 24
POSTGRES_PASSWORD=

# [可选] PostgreSQL 数据库名（默认 aiops）
POSTGRES_DB=aiops

# [可选] PostgreSQL 数据库用户（默认 aiops）
POSTGRES_USER=aiops

# [可选] PostgreSQL SSL 模式（生产若使用云数据库建议 require）
# disable | require | verify-ca | verify-full
AIOPS_DATABASE__SSL_MODE=disable

# ----------------------------------------------------------------------------
# Redis 配置
# ----------------------------------------------------------------------------

# [建议] Redis 密码（生产建议设置）
# 生成方式：openssl rand -base64 24
# 留空则 Redis 不启用密码认证
AIOPS_REDIS__PASSWORD=

# ----------------------------------------------------------------------------
# 认证与 JWT 配置
# ----------------------------------------------------------------------------

# [必填] JWT 签名密钥
# 要求：>=32 字节高熵随机值，不能使用 dev 占位符，不能与下方凭据加密密钥相同。
# 生成方式：openssl rand -base64 32
AIOPS_AUTH__JWT_SECRET=

# [可选] Token 有效期（生产 compose 默认 60min / 72h；可按 30–60min / 24–72h 调整）
# AIOPS_AUTH__ACCESS_TTL_M=60
# AIOPS_AUTH__REFRESH_TTL_H=72

# ----------------------------------------------------------------------------
# Integration 凭据加密配置
# ----------------------------------------------------------------------------

# [必填] 接入凭据加密密钥
# 用于加密云账号 AK/SK、Token 等接入凭据。
# 要求：独立强随机值，不能为空，不能使用 dev 占位符，不能与 AIOPS_AUTH__JWT_SECRET 相同。
# 生成方式：openssl rand -base64 32
AIOPS_INTEGRATION__CREDENTIAL_ENCRYPTION_KEY=

# [可选] 凭据加密密钥版本号（用于密钥轮换，默认 1）
AIOPS_INTEGRATION__CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# ----------------------------------------------------------------------------
# CORS 配置
# ----------------------------------------------------------------------------

# [建议] 允许的前端 origin（分域部署时必填，同源反代可留空）
# 生产禁止使用通配符 *，须填写实际域名。
# 多个域名用英文逗号分隔，例如：https://app.example.com,https://admin.example.com
# 同源反代模式（Nginx 将 /api/* 反代到 API）时留空即可。
AIOPS_CORS__ALLOW_ORIGINS=

# ----------------------------------------------------------------------------
# 执行代理配置
# ----------------------------------------------------------------------------

# [必填] 执行代理注册令牌
# 要求：>=32 字节高熵随机值，字符类与熵要求同 JWT（勿用 hex-only，易校验失败）。
# 生成方式：openssl rand -base64 32
AIOPS_EXECUTION__AGENT_REGISTER_TOKEN=

# ----------------------------------------------------------------------------
# 镜像配置
# ----------------------------------------------------------------------------

# [必填] 完整镜像引用（生产 compose 仅 pull，不在 compose 中 build；版本元数据由 CI 构建镜像时注入）
# 优先 digest（如 registry.example.com/aiops-api@sha256:abcdef...），
# 其次不可变版本号（如 registry.example.com/aiops-api:v1.2.0）。
# 禁止使用 latest；docker-compose.prod.yml 在 AIOPS_IMAGE 未设置时会直接报错。
# 上线前必须先运行 scripts/verify-prod-version.ps1（或 scripts/deploy-prod.ps1 -SkipUp）校验本变量。
# scripts/deploy-prod.ps1 已扩展为完整发布链路（备份→migrate→verify→建管理员→up API→/readyz），
# 加 -SkipUp 才退化为仅校验镜像；详见 docs/release-checklist.md §9。
# 注意：不要传纯 tag（如 v1.2.0）或纯 digest（如 sha256:...），必须是完整引用。
AIOPS_IMAGE=
