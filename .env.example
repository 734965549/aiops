# 通过环境变量覆盖 configs/config.yaml 的配置项。
# 命名规则：AIOPS_<SECTION>__<KEY>，全部大写，YAML 分段用「双下划线」分隔。
# 键名内部的 snake_case 单下划线保留不变。
#
# 例：
#   AIOPS_SERVER__PORT=9090            -> server.port
#   AIOPS_DATABASE__SSL_MODE=require   -> database.ssl_mode
#   AIOPS_AUTH__JWT_SECRET=xxx         -> auth.jwt_secret

AIOPS_APP__NAME=aiops
AIOPS_APP__ENV=dev
AIOPS_APP__TIMEZONE=Asia/Shanghai

AIOPS_SERVER__HOST=0.0.0.0
AIOPS_SERVER__PORT=8080
AIOPS_SERVER__READ_TIMEOUT_S=15
AIOPS_SERVER__WRITE_TIMEOUT_S=30
AIOPS_SERVER__SHUTDOWN_TIMEOUT_S=10

AIOPS_LOGGER__LEVEL=info
AIOPS_LOGGER__FORMAT=console
AIOPS_LOGGER__OUTPUT=stdout
AIOPS_LOGGER__FILE_PATH=logs/aiops.log
AIOPS_LOGGER__MAX_SIZE_MB=100
AIOPS_LOGGER__MAX_BACKUPS=10
AIOPS_LOGGER__MAX_AGE_DAYS=30

AIOPS_DATABASE__DRIVER=postgres
AIOPS_DATABASE__HOST=127.0.0.1
AIOPS_DATABASE__PORT=5432
AIOPS_DATABASE__USER=aiops
AIOPS_DATABASE__PASSWORD=aiops
AIOPS_DATABASE__NAME=aiops
AIOPS_DATABASE__SSL_MODE=disable
AIOPS_DATABASE__MAX_IDLE_CONNS=10
AIOPS_DATABASE__MAX_OPEN_CONNS=100
AIOPS_DATABASE__CONN_MAX_LIFETIME_S=60
AIOPS_DATABASE__LOG_LEVEL=warn
# 默认关闭代码内自动迁移；建表、初始化数据等动作应由 DBA 或外部发布流程执行。
AIOPS_DATABASE__AUTO_MIGRATE=false

# prod 须设 AIOPS_REDIS__REQUIRED=true；refresh token 轮换依赖 Redis 会话存储。
AIOPS_REDIS__REQUIRED=false
AIOPS_REDIS__ADDR=127.0.0.1:6379
AIOPS_REDIS__USERNAME=
AIOPS_REDIS__PASSWORD=
AIOPS_REDIS__DB=0
AIOPS_REDIS__POOL_SIZE=50

# dev 本地 go run：可使用 please-change-me-in-production 或 dev-only-not-secret-please-change。
# docker compose 主文件无 .env 时使用 dev 占位 JWT；生产须注入强 JWT_SECRET。
# 非 dev 环境必须注入高熵强密钥（>=32 字节、拒绝弱密钥列表）。
AIOPS_AUTH__JWT_SECRET=please-change-me-in-production
# docker compose -f deployments/docker-compose.yml 所需（dev 覆盖文件会改写 api 容器内值）
JWT_SECRET=dev-only-not-secret-please-change
AIOPS_AUTH__JWT_ISSUER=aiops
AIOPS_AUTH__ACCESS_TTL_M=120
AIOPS_AUTH__REFRESH_TTL_H=168
# 可选：仅 dev/test 初始化默认管理员；prod 必须留空。
AIOPS_AUTH__BOOTSTRAP_USERNAME=admin
AIOPS_AUTH__BOOTSTRAP_PASSWORD=admin123
AIOPS_AUTH__BOOTSTRAP_DISPLAY_NAME=Administrator
# 登录安全 IP 白名单；留空表示唔限制，支持单 IP 同 CIDR，多个值用英文逗号分隔。
# AIOPS_AUTH__LOGIN_IP_ALLOWLIST=10.0.0.0/8,192.168.1.10

# Integration 接入账号凭据加密密钥；aiops-api:1.2 起非 dev 环境必填。
# 生产须使用独立强随机值，不能使用 dev 占位符，不能与 AIOPS_AUTH__JWT_SECRET 相同。
# 生成示例：openssl rand -base64 32
AIOPS_INTEGRATION__CREDENTIAL_ENCRYPTION_KEY=dev-integration-credential-key-change-me
AIOPS_INTEGRATION__CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# slice 类配置通过环境变量覆盖时，使用英文逗号分隔多个值（无空格或自行 trim）：
# AIOPS_CORS__ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 更推荐在 configs/config.yaml 中以 YAML 数组维护；allow_credentials=true 时禁止使用 *。
AIOPS_CORS__ALLOW_ORIGINS=http://localhost:5173
AIOPS_CORS__ALLOW_CREDENTIALS=true

# AI providers 无法通过简单 env 键整段注入；二选一：
#   1. 在 configs/config.yaml 的 ai.providers 数组中维护（启动时自动载入内存注册表）；
#   2. 启动后通过 POST /api/ai/providers 手动创建（需已登录且具备 app:ai.providers:write）。
# 见 configs/config.example.yaml 中 ai.providers 示例与 ops/ai-contract.md。
